# 前端访问密码（自己设一个）
CHAT_PASSWORD=your-password-here
CHAT_SECRET=your-secret-here

# HTTP Basic Auth（可选）
BASIC_AUTH_USER=your-username
BASIC_AUTH_PASSWORD=your-password

# 默认 OpenAI-compatible API（可选，也可以在网页里配置）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-openai-compatible-key
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Messages API（可选）
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 通用兜底（可选）
# EXTERNAL_API_KEY=replace-with-your-api-key
# EXTERNAL_MODEL=gpt-4.1-mini
